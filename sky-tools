#!/usr/bin/env bash
set -euo pipefail

readonly NVM_INSTALL_VERSION="${SKY_TOOLS_NVM_VERSION:-v0.40.1}"
readonly CORRETTO_VERSION="${SKY_TOOLS_CORRETTO_VERSION:-25}"
readonly NVM_DIR="${HOME}/.nvm"
readonly RUSTUP_HOME="${HOME}/.rustup"
readonly CARGO_HOME="${HOME}/.cargo"
readonly BUN_INSTALL="${HOME}/.bun"
readonly DOTNET_ROOT="${HOME}/.dotnet"
readonly GO_INSTALL_ROOT="${HOME}/.go"
readonly JDK_INSTALL_ROOT="${HOME}/.jdk"
readonly FZF_HOME="${HOME}/.fzf"
readonly OPAMROOT="${HOME}/.opam"
readonly ELAN_HOME="${HOME}/.elan"
readonly PNPM_HOME="${HOME}/.local/share/pnpm"
readonly LOCAL_BIN="${HOME}/.local/bin"
readonly STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/sky-tools"

export NVM_DIR RUSTUP_HOME CARGO_HOME BUN_INSTALL DOTNET_ROOT FZF_HOME OPAMROOT ELAN_HOME PNPM_HOME
export GOROOT="${GO_INSTALL_ROOT}/current"
export GOPATH="${HOME}/go"
export JAVA_HOME="${JDK_INSTALL_ROOT}/current"
export UV_INSTALL_DIR="${LOCAL_BIN}"
export UV_NO_MODIFY_PATH=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export PATH="${LOCAL_BIN}:${PNPM_HOME}/bin:${PNPM_HOME}:${CARGO_HOME}/bin:${BUN_INSTALL}/bin:${DOTNET_ROOT}:${GOROOT}/bin:${GOPATH}/bin:${JAVA_HOME}/bin:${FZF_HOME}/bin:${OPAMROOT}/default/bin:${ELAN_HOME}/bin:${PATH}"

usage() {
  cat <<'EOF'
usage: sky-tools <command>

Commands:
  ensure  Install missing developer tools without updating existing ones
  update  Install missing tools, then update all managed tools
  status  Show installed tool versions
EOF
}

log() {
  printf 'sky-tools: %s\n' "$*"
}

ensure_managed_tool() {
  local label started_at
  label="$1"
  shift
  started_at=${SECONDS}
  log "checking ${label}"
  "$@"
  log "${label} is available ($((SECONDS - started_at))s)"
}

download_to_stdout() {
  curl --retry 5 --retry-all-errors --retry-delay 2 -fsSL "$1"
}

with_lock() {
  mkdir -p "${STATE_DIR}"
  exec 9>"${STATE_DIR}/lock"
  if command -v flock >/dev/null 2>&1; then
    flock 9
  fi
  "$@"
}

load_nvm() {
  if [[ -s "${NVM_DIR}/nvm.sh" ]]; then
    # shellcheck source=/dev/null
    source "${NVM_DIR}/nvm.sh"
    return 0
  fi
  return 1
}

link_node_commands() {
  mkdir -p "${LOCAL_BIN}"
  local command_name command_path node_path node_version_dir
  node_path=$(nvm which default)
  node_version_dir=${node_path%/bin/node}

  # Keep the public command links stable when nvm installs a newer Node version.
  # Only this pointer needs to change; ~/.local/bin never points at a versioned
  # directory that may later be removed.
  ln -sfnT "${node_version_dir}" "${NVM_DIR}/current"

  for command_name in node npm npx pnpm pnpx; do
    command_path="${NVM_DIR}/current/bin/${command_name}"
    if [[ -x "${command_path}" ]]; then
      ln -sfn "${command_path}" "${LOCAL_BIN}/${command_name}"
    fi
  done
}

ensure_uv() {
  if [[ ! -x "${LOCAL_BIN}/uv" ]]; then
    log "installing uv"
    download_to_stdout https://astral.sh/uv/install.sh | sh
  fi
}

ensure_rust() {
  if [[ ! -x "${CARGO_HOME}/bin/rustup" ]]; then
    log "installing Rust"
    download_to_stdout https://sh.rustup.rs | sh -s -- -y --no-modify-path
  fi
}

ensure_node() {
  if [[ ! -s "${NVM_DIR}/nvm.sh" ]]; then
    log "installing nvm ${NVM_INSTALL_VERSION}"
    mkdir -p "${NVM_DIR}"
    PROFILE=/dev/null download_to_stdout \
      "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_INSTALL_VERSION}/install.sh" | \
      PROFILE=/dev/null bash
  fi
  load_nvm
  if [[ "$(nvm version 'lts/*')" == "N/A" ]]; then
    log "installing Node.js LTS"
    nvm install --lts
  fi
  nvm alias default 'lts/*' >/dev/null
  nvm use --silent default
  if ! command -v pnpm >/dev/null 2>&1; then
    log "installing pnpm"
    npm install --global pnpm
  fi
  link_node_commands
}

ensure_bun() {
  if [[ ! -x "${BUN_INSTALL}/bin/bun" ]]; then
    log "installing Bun"
    download_to_stdout https://bun.sh/install | bash
  fi
}

install_dotnet_lts() {
  local installer
  installer=$(mktemp)
  download_to_stdout https://dot.net/v1/dotnet-install.sh > "${installer}"
  bash "${installer}" --install-dir "${DOTNET_ROOT}" --channel LTS
  rm -f "${installer}"
}

ensure_dotnet() {
  if [[ ! -x "${DOTNET_ROOT}/dotnet" ]]; then
    log "installing .NET LTS"
    mkdir -p "${DOTNET_ROOT}"
    install_dotnet_lts
  fi
}

go_architecture() {
  case "$(uname -m)" in
    x86_64|amd64)
      printf 'amd64\n'
      ;;
    aarch64|arm64)
      printf 'arm64\n'
      ;;
    *)
      echo "sky-tools: Go does not support architecture $(uname -m) in this container" >&2
      return 1
      ;;
  esac
}

latest_go_asset() {
  local architecture archive asset checksum release
  architecture=$(go_architecture)
  asset=$(
    download_to_stdout 'https://go.dev/dl/?mode=json' | jq -er --arg architecture "${architecture}" '
      [
        .[]
        | select(.stable)
        | . as $release
        | $release.files[]
        | select(.os == "linux" and .arch == $architecture and .kind == "archive")
        | [$release.version, .filename, .sha256]
      ][0]
      | @tsv
    '
  )
  IFS=$'\t' read -r release archive checksum <<< "${asset}"
  if [[ ! "${release}" =~ ^go[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] ||
     [[ "${archive}" != "${release}.linux-${architecture}.tar.gz" ]] ||
     [[ ! "${checksum}" =~ ^[0-9a-f]{64}$ ]]; then
    echo "sky-tools: could not determine the latest stable Go release" >&2
    return 1
  fi
  printf '%s\n' "${asset}"
}

install_go_asset() {
  local archive checksum release temp_dir target
  release="$1"
  archive="$2"
  checksum="$3"
  temp_dir=$(mktemp -d)
  target="${GO_INSTALL_ROOT}/releases/${release}"

  (
    trap 'rm -rf "${temp_dir}"' EXIT
    download_to_stdout "https://go.dev/dl/${archive}" > "${temp_dir}/${archive}"
    printf '%s  %s\n' "${checksum}" "${temp_dir}/${archive}" | sha256sum --check --status
    tar -xzf "${temp_dir}/${archive}" -C "${temp_dir}"
    [[ -x "${temp_dir}/go/bin/go" ]] || {
      echo "sky-tools: Go archive has an unexpected layout" >&2
      return 1
    }
    mkdir -p "${GO_INSTALL_ROOT}/releases"
    if [[ ! -x "${target}/bin/go" ]]; then
      rm -rf "${target}"
      mv "${temp_dir}/go" "${target}"
    fi
    ln -sfnT "${target}" "${GO_INSTALL_ROOT}/current"
  )
}

ensure_go() {
  if [[ ! -x "${GOROOT}/bin/go" ]]; then
    local archive checksum release
    IFS=$'\t' read -r release archive checksum < <(latest_go_asset)
    log "installing Go ${release}"
    install_go_asset "${release}" "${archive}" "${checksum}"
  fi
}

update_go() {
  local archive checksum installed_release release
  IFS=$'\t' read -r release archive checksum < <(latest_go_asset)
  installed_release=$(
    "${GOROOT}/bin/go" version | awk '{ print $3 }'
  )
  if [[ "${installed_release}" != "${release}" ]]; then
    log "updating Go ${installed_release} -> ${release}"
    install_go_asset "${release}" "${archive}" "${checksum}"
  fi
}

corretto_architecture() {
  case "$(uname -m)" in
    x86_64|amd64)
      printf 'x64\n'
      ;;
    aarch64|arm64)
      printf 'aarch64\n'
      ;;
    *)
      echo "sky-tools: Amazon Corretto does not support architecture $(uname -m) in this container" >&2
      return 1
      ;;
  esac
}

latest_corretto_asset() {
  local architecture archive checksum download_url
  if [[ ! "${CORRETTO_VERSION}" =~ ^[0-9]+$ ]]; then
    echo "sky-tools: invalid Amazon Corretto version ${CORRETTO_VERSION}" >&2
    return 1
  fi
  architecture=$(corretto_architecture)
  archive="amazon-corretto-${CORRETTO_VERSION}-${architecture}-linux-jdk.tar.gz"
  download_url="https://corretto.aws/downloads/latest/${archive}"
  checksum=$(
    download_to_stdout "https://corretto.aws/downloads/latest_sha256/${archive}"
  )
  if [[ ! "${checksum}" =~ ^[0-9a-f]{64}$ ]]; then
    echo "sky-tools: could not determine the latest Amazon Corretto ${CORRETTO_VERSION} checksum" >&2
    return 1
  fi
  printf '%s\t%s\t%s\n' "${archive}" "${download_url}" "${checksum}"
}

install_corretto_asset() {
  local archive checksum download_url temp_dir target
  archive="$1"
  download_url="$2"
  checksum="$3"
  temp_dir=$(mktemp -d)
  target="${JDK_INSTALL_ROOT}/releases/corretto-${CORRETTO_VERSION}-${checksum:0:16}"

  (
    trap 'rm -rf "${temp_dir}"' EXIT
    mkdir -p "${temp_dir}/extracted"
    download_to_stdout "${download_url}" > "${temp_dir}/${archive}"
    printf '%s  %s\n' "${checksum}" "${temp_dir}/${archive}" | sha256sum --check --status
    tar -xzf "${temp_dir}/${archive}" -C "${temp_dir}/extracted"

    shopt -s nullglob dotglob
    local extracted_entries=("${temp_dir}/extracted"/*)
    if (( ${#extracted_entries[@]} != 1 )) || [[ ! -x "${extracted_entries[0]}/bin/java" ]]; then
      echo "sky-tools: Amazon Corretto archive has an unexpected layout" >&2
      return 1
    fi
    mkdir -p "${JDK_INSTALL_ROOT}/releases"
    if [[ ! -x "${target}/bin/java" ]]; then
      rm -rf "${target}"
      mv "${extracted_entries[0]}" "${target}"
    fi
    printf '%s\n' "amazon-corretto-${CORRETTO_VERSION}" > "${target}/.sky-tools-provider"
    printf '%s\n' "${checksum}" > "${target}/.sky-tools-sha256"
    ln -sfnT "${target}" "${JDK_INSTALL_ROOT}/current"
  )
}

ensure_jdk() {
  local expected_provider
  expected_provider="amazon-corretto-${CORRETTO_VERSION}"
  if [[ ! -x "${JAVA_HOME}/bin/java" ||
        ! -x "${JAVA_HOME}/bin/javac" ||
        ! -f "${JAVA_HOME}/.sky-tools-provider" ||
        "$(<"${JAVA_HOME}/.sky-tools-provider")" != "${expected_provider}" ]]; then
    local archive checksum download_url
    IFS=$'\t' read -r archive download_url checksum < <(latest_corretto_asset)
    log "installing Amazon Corretto ${CORRETTO_VERSION}"
    install_corretto_asset "${archive}" "${download_url}" "${checksum}"
  fi
}

update_jdk() {
  local archive checksum download_url installed_checksum
  IFS=$'\t' read -r archive download_url checksum < <(latest_corretto_asset)
  installed_checksum="unknown"
  if [[ -f "${JAVA_HOME}/.sky-tools-sha256" ]]; then
    installed_checksum=$(<"${JAVA_HOME}/.sky-tools-sha256")
  fi
  if [[ "${installed_checksum}" != "${checksum}" ]]; then
    log "updating Amazon Corretto ${CORRETTO_VERSION}"
    install_corretto_asset "${archive}" "${download_url}" "${checksum}"
  fi
}

ensure_fzf() {
  if [[ ! -x "${FZF_HOME}/bin/fzf" ]]; then
    log "installing fzf"
    if [[ ! -d "${FZF_HOME}/.git" ]]; then
      git clone --depth 1 https://github.com/junegunn/fzf.git "${FZF_HOME}"
    fi
    "${FZF_HOME}/install" --bin
  fi
}

github_cli_architecture() {
  case "$(uname -m)" in
    x86_64|amd64)
      printf 'amd64\n'
      ;;
    aarch64|arm64)
      printf 'arm64\n'
      ;;
    *)
      echo "sky-tools: GitHub CLI does not support architecture $(uname -m)" >&2
      return 1
      ;;
  esac
}

latest_github_cli_version() {
  local version
  version=$(download_to_stdout https://api.github.com/repos/cli/cli/releases/latest | jq -r '.tag_name // empty')
  version=${version#v}
  if [[ ! "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "sky-tools: could not determine the latest GitHub CLI version" >&2
    return 1
  fi
  printf '%s\n' "${version}"
}

installed_github_cli_version() {
  "${LOCAL_BIN}/gh" --version | awk 'NR == 1 { print $3 }'
}

install_github_cli_version() {
  local architecture archive checksums expected_checksum release_url temp_dir version
  version="$1"
  architecture=$(github_cli_architecture)
  archive="gh_${version}_linux_${architecture}.tar.gz"
  checksums="gh_${version}_checksums.txt"
  release_url="https://github.com/cli/cli/releases/download/v${version}"
  mkdir -p "${LOCAL_BIN}"
  temp_dir=$(mktemp -d)

  (
    trap 'rm -rf "${temp_dir}"' EXIT
    download_to_stdout "${release_url}/${archive}" > "${temp_dir}/${archive}"
    download_to_stdout "${release_url}/${checksums}" > "${temp_dir}/${checksums}"

    expected_checksum=$(awk -v archive="${archive}" '$2 == archive { print $1 }' "${temp_dir}/${checksums}")
    if [[ ! "${expected_checksum}" =~ ^[0-9a-f]{64}$ ]]; then
      echo "sky-tools: GitHub CLI release does not contain a checksum for ${archive}" >&2
      return 1
    fi
    printf '%s  %s\n' "${expected_checksum}" "${temp_dir}/${archive}" | sha256sum --check --status

    tar -xzf "${temp_dir}/${archive}" -C "${temp_dir}"
    install -m 0755 \
      "${temp_dir}/gh_${version}_linux_${architecture}/bin/gh" \
      "${LOCAL_BIN}/gh"
  )
}

ensure_github_cli() {
  if [[ ! -x "${LOCAL_BIN}/gh" ]]; then
    local version
    version=$(latest_github_cli_version)
    log "installing GitHub CLI ${version}"
    install_github_cli_version "${version}"
  fi
}

update_github_cli() {
  local installed_version latest_version
  installed_version=$(installed_github_cli_version)
  latest_version=$(latest_github_cli_version)
  if [[ "${installed_version}" != "${latest_version}" ]]; then
    log "updating GitHub CLI ${installed_version} -> ${latest_version}"
    install_github_cli_version "${latest_version}"
  fi
}

install_opam() {
  local installer
  installer=$(mktemp)
  if ! download_to_stdout https://opam.ocaml.org/install.sh > "${installer}"; then
    rm -f "${installer}"
    return 1
  fi
  if ! printf '%s\n' "${LOCAL_BIN}" | sh "${installer}" --no-backup; then
    rm -f "${installer}"
    return 1
  fi
  rm -f "${installer}"
}

latest_ocaml_compiler() {
  local version
  version=$(
    "${LOCAL_BIN}/opam" show \
      ocaml-base-compiler \
      --all-versions \
      --field=version | \
      grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | \
      sort -V | \
      tail -n 1
  )
  if [[ -z "${version}" ]]; then
    echo "sky-tools: no stable OCaml compiler is available" >&2
    return 1
  fi
  printf 'ocaml-base-compiler.%s\n' "${version}"
}

ensure_opam() {
  if [[ ! -x "${LOCAL_BIN}/opam" ]]; then
    log "installing opam"
    install_opam
  fi
  if [[ ! -f "${OPAMROOT}/config" ]]; then
    log "initializing opam"
    "${LOCAL_BIN}/opam" init \
      --bare \
      --disable-sandboxing \
      --enable-shell-hook \
      --no-setup \
      --shell=zsh \
      --yes
  fi
  if ! "${LOCAL_BIN}/opam" switch list --short | grep -qx default; then
    log "installing OCaml"
    local compiler
    compiler=$(latest_ocaml_compiler)
    "${LOCAL_BIN}/opam" switch create \
      default \
      "${compiler}" \
      --yes
  fi
}

ensure_elan() {
  if [[ ! -x "${ELAN_HOME}/bin/elan" ]]; then
    log "installing elan and Lean 4 stable"
    download_to_stdout https://elan.lean-lang.org/elan-init.sh | \
      sh -s -- \
        -y \
        --no-modify-path \
        --default-toolchain leanprover/lean4:stable
  elif ! (cd "${HOME}" && "${ELAN_HOME}/bin/lean" --version >/dev/null 2>&1); then
    log "installing Lean 4 stable"
    "${ELAN_HOME}/bin/elan" default leanprover/lean4:stable
  fi
}

ensure_claude() {
  if [[ ! -x "${LOCAL_BIN}/claude" ]]; then
    log "installing Claude Code"
    download_to_stdout https://claude.ai/install.sh | bash
  fi
}

ensure_codex() {
  if [[ ! -x "${LOCAL_BIN}/codex" ]]; then
    log "installing Codex"
    download_to_stdout https://chatgpt.com/codex/install.sh | sh
  fi
}

ensure_pi() {
  if [[ ! -x "${PNPM_HOME}/bin/pi" && ! -x "${PNPM_HOME}/pi" ]]; then
    log "installing pi"
    mkdir -p "${PNPM_HOME}/bin"
    pnpm add --global --ignore-scripts @earendil-works/pi-coding-agent
  fi
}

ensure_all() {
  mkdir -p "${LOCAL_BIN}"
  ensure_managed_tool uv ensure_uv
  ensure_managed_tool Rust ensure_rust
  ensure_managed_tool Node.js ensure_node
  ensure_managed_tool Bun ensure_bun
  ensure_managed_tool .NET ensure_dotnet
  ensure_managed_tool Go ensure_go
  ensure_managed_tool "Amazon Corretto JDK" ensure_jdk
  ensure_managed_tool fzf ensure_fzf
  ensure_managed_tool "GitHub CLI" ensure_github_cli
  ensure_managed_tool opam/OCaml ensure_opam
  ensure_managed_tool "Lean 4" ensure_elan
  ensure_managed_tool "Claude Code" ensure_claude
  ensure_managed_tool Codex ensure_codex
  ensure_managed_tool pi ensure_pi
  log "all tools are available"
}

update_all() {
  ensure_all

  log "updating uv"
  "${LOCAL_BIN}/uv" self update

  log "updating Rust"
  "${CARGO_HOME}/bin/rustup" update

  log "updating Node.js LTS, npm, and pnpm"
  load_nvm
  nvm install --lts --latest-npm
  nvm alias default 'lts/*' >/dev/null
  nvm use --silent default
  npm install --global pnpm@latest
  link_node_commands

  log "updating Bun"
  "${BUN_INSTALL}/bin/bun" upgrade

  log "updating .NET LTS"
  install_dotnet_lts

  update_go

  update_jdk

  log "updating fzf"
  git -C "${FZF_HOME}" pull --ff-only
  "${FZF_HOME}/install" --bin

  update_github_cli

  log "updating opam and OCaml packages"
  install_opam
  "${LOCAL_BIN}/opam" init \
    --disable-sandboxing \
    --enable-shell-hook \
    --no-setup \
    --reinit \
    --shell=zsh \
    --yes
  "${LOCAL_BIN}/opam" update --yes
  local compiler
  compiler=$(latest_ocaml_compiler)
  "${LOCAL_BIN}/opam" switch set-invariant \
    --switch=default \
    "${compiler}" \
    --yes
  "${LOCAL_BIN}/opam" upgrade --switch=default --yes

  log "updating elan and Lean 4 stable"
  "${ELAN_HOME}/bin/elan" self update
  "${ELAN_HOME}/bin/elan" default leanprover/lean4:stable

  log "updating Claude Code"
  "${LOCAL_BIN}/claude" update

  log "updating Codex"
  download_to_stdout https://chatgpt.com/codex/install.sh | sh

  log "updating pi"
  pnpm add --global --ignore-scripts @earendil-works/pi-coding-agent@latest

  log "all tools are up to date"
}

version_line() {
  local label="$1"
  shift
  local output
  if output=$("$@" 2>&1); then
    output=${output%%$'\n'*}
  else
    output="not installed"
  fi
  printf '%-12s %s\n' "${label}" "${output}"
}

ocaml_version() {
  "${LOCAL_BIN}/opam" exec --switch=default -- ocaml -version
}

lean_version() {
  (cd "${HOME}" && "${ELAN_HOME}/bin/lean" --version)
}

show_status() {
  if load_nvm; then
    nvm use --silent default >/dev/null 2>&1 || true
  fi
  version_line uv "${LOCAL_BIN}/uv" --version
  version_line rust "${CARGO_HOME}/bin/rustc" --version
  version_line rustup "${CARGO_HOME}/bin/rustup" --version
  version_line nvm nvm --version
  version_line node node --version
  version_line npm npm --version
  version_line pnpm pnpm --version
  version_line bun "${BUN_INSTALL}/bin/bun" --version
  version_line dotnet "${DOTNET_ROOT}/dotnet" --version
  version_line go "${GOROOT}/bin/go" version
  version_line java "${JAVA_HOME}/bin/java" -version
  version_line javac "${JAVA_HOME}/bin/javac" -version
  version_line fzf "${FZF_HOME}/bin/fzf" --version
  version_line gh "${LOCAL_BIN}/gh" --version
  version_line opam "${LOCAL_BIN}/opam" --version
  version_line ocaml ocaml_version
  version_line elan "${ELAN_HOME}/bin/elan" --version
  version_line lean lean_version
  version_line claude "${LOCAL_BIN}/claude" --version
  version_line codex "${LOCAL_BIN}/codex" --version
  version_line pi pi --version
}

case "${1:-}" in
  ensure)
    shift
    (( $# == 0 )) || { usage >&2; exit 2; }
    with_lock ensure_all
    ;;
  update)
    shift
    (( $# == 0 )) || { usage >&2; exit 2; }
    with_lock update_all
    ;;
  status)
    shift
    (( $# == 0 )) || { usage >&2; exit 2; }
    show_status
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
